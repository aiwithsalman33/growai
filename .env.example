# Partner.ai — environment configuration
#
# Copy to .env and fill in. `.env` is gitignored and must never be committed.
# One file at the repo root serves the whole monorepo: Docker Compose reads it
# for every service, the backend loads it through dotenv, and Vite reads the
# VITE_* entries at build time.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database — PostgreSQL in Docker is the only datastore
# ---------------------------------------------------------------------------
POSTGRES_USER=partner_admin
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=partner_ai

# Host must be the compose service name `postgres`, not localhost.
# Keep the credentials below in sync with the three values above.
DATABASE_URL=postgresql://partner_admin:change-this-password@postgres:5432/partner_ai

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Token signing. Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Encrypts Google OAuth tokens at rest. Must be exactly 64 hex characters
# (32 bytes) or the server refuses to start. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Session lifetimes. Defaults shown.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---------------------------------------------------------------------------
# Platform owner
# Seeded as a super_admin by `make seed`. Re-seeding after changing the
# password rotates the credential. Leave blank to skip creating this account.
# ---------------------------------------------------------------------------
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-this-password

# Password for the three seeded demo accounts (elena / marcus / alex).
SEED_PASSWORD=Partner.ai2024

# ---------------------------------------------------------------------------
# Google Business Profile OAuth
# From Google Cloud Console. Without these the GBP service runs in simulated
# mode: publishes and replies are logged instead of sent, and reads come back
# empty. GET /api/health reports which mode is active.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gbp/oauth/callback

# ---------------------------------------------------------------------------
# AI review replies
# Without a key the reply endpoints return 503 rather than inventing text.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Frontend (Vite)
# Only VITE_-prefixed vars reach the browser, and they are baked into the
# bundle at build time — change them before building, not after.
# ---------------------------------------------------------------------------
# Relative on purpose: nginx proxies it in production and the Vite dev server
# proxies it in development, so one value is correct in both modes.
VITE_API_URL=/api

# Where the SPA is served from. Used for CORS and OAuth redirects back in.
FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Post scheduler — a Postgres poll, not a queue
# ---------------------------------------------------------------------------
SCHEDULER_INTERVAL_MS=30000
SCHEDULER_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
API_RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT=20
AI_RATE_LIMIT_PER_MIN=10
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Host port nginx publishes. A managed host (Dokploy, Coolify) usually already
# has a router on :80 — set a free port here and point the platform at it.
NGINX_PORT=80

# Run the seed once on backend startup. Leave false after the first deploy, or
# the seeded passwords are reset on every restart.
RUN_SEED=false
