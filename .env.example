# Copy to .env and fill in. `.env` is gitignored.

# Postgres (Docker only — no external DB)
POSTGRES_USER=partner_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=partner_ai
# Host is the compose service name `postgres`, not localhost.
DATABASE_URL=postgresql://partner_admin:changeme@postgres:5432/partner_ai

# Backend
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 32-byte hex (64 chars), for encrypting GBP OAuth tokens at rest.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Google Business Profile OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gbp/oauth/callback

# AI review replies
ANTHROPIC_API_KEY=

# Where the browser should reach the API. Relative on purpose: nginx proxies
# it in production and the Vite dev server proxies it in development
# (see vite.config.ts), so one value is correct in both modes.
VITE_API_URL=/api

# Where the SPA is served from, for OAuth redirects back into the app.
FRONTEND_ORIGIN=http://localhost:3000

# Post scheduler poll interval (ms). Postgres-polled — there is no queue.
SCHEDULER_INTERVAL_MS=30000
